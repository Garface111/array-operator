# Array Operator preprod pipeline config (sourced by scripts/deploy-preprod.sh).
# Non-secret. Secrets (Netlify PAT) come from NETLIFY_TOKEN_FILE; the beta
# password + IP allowlist live as Netlify site env vars on the preprod site.

# Netlify preprod preview site (repurposed idle "ao-owner-web-preview").
PREPROD_SITE_ID="f6c82d88-8d69-4f88-abac-df195a34fe77"
PREPROD_SITE_NAME="ao-owner-web-preview"
PREPROD_ORIGIN="https://ao-owner-web-preview.netlify.app"

# Backend origins. The preprod frontend proxies /v1/* and /accounts to the
# STAGING backend; deploy-preprod.sh rewrites _redirects from prod -> staging.
PROD_API_ORIGIN="https://web-production-49c83.up.railway.app"
STAGING_API_ORIGIN="https://web-staging-staging-3671.up.railway.app"

# Branch that represents "preprod" (tested here before promotion to main/prod).
PREPROD_BRANCH="staging"

# Netlify auth: a Personal Access Token file (bypasses the expired CLI login).
NETLIFY_TOKEN_FILE="${NETLIFY_TOKEN_FILE:-$HOME/.hermes/secrets/netlify_token}"
