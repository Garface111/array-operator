{
  "name": "@array-operator/owner-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Array Operator — phone-first React app (web /m + Capacitor store shells).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:web": "tsc --noEmit && VITE_BASE=/m/ vite build",
    "build:native": "tsc --noEmit && VITE_BASE=./ VITE_API_BASE=https://arrayoperator.com VITE_SITE_ORIGIN=https://arrayoperator.com vite build",
    "cap:sync": "npm run build:native && npx cap sync",
    "cap:android": "npm run build:native && npx cap sync android",
    "cap:ios": "npm run build:native && npx cap sync ios",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run",
    "store:android": "bash scripts/store/build-android-release.sh",
    "store:icons": "npx @capacitor/assets generate --iconBackgroundColor '#f0f9ff' --iconBackgroundColorDark '#0a0e14' --splashBackgroundColor '#f0f9ff' --splashBackgroundColorDark '#0a0e14' || true"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
