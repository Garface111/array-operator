{
	"appId": "com.arrayoperator.app",
	"appName": "Array Operator",
	"webDir": "dist",
	"bundledWebRuntime": false,
	"server": {
		"androidScheme": "https",
		"iosScheme": "https",
		"allowNavigation": [
			"arrayoperator.com",
			"*.arrayoperator.com",
			"nepooloperator.com",
			"*.nepooloperator.com",
			"solaroperator.org",
			"*.stripe.com",
			"checkout.stripe.com",
			"connect.stripe.com"
		]
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 1200,
			"launchAutoHide": true,
			"backgroundColor": "#f0f9ff",
			"showSpinner": false,
			"androidScaleType": "CENTER_CROP",
			"splashFullScreen": true,
			"splashImmersive": true
		},
		"StatusBar": {
			"style": "LIGHT",
			"backgroundColor": "#f0f9ff"
		},
		"Keyboard": {
			"resize": "body",
			"resizeOnFullScreen": true
		}
	},
	"android": {
		"allowMixedContent": false,
		"backgroundColor": "#f0f9ff"
	},
	"ios": {
		"backgroundColor": "#f0f9ff",
		"contentInset": "automatic",
		"preferredContentMode": "mobile",
		"scheme": "Array Operator"
	}
}
